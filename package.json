{
  "name": "pnpm-rollup-ts-template",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "watch": "tsx --watch ./src/index.ts",
    "lint": "eslint ./src & eslint ./__tests__",
    "dev": "rollup -c rollup.config.ts --configPlugin esbuild -w",
    "test": "tsx --test $(find __tests__ -type f -name '*.test.ts')",
    "test::coverage": "jest --coverage --config=jest.config.ts",
    "build::clean": "rimraf ./dist",
    "build::proc": "rollup -c rollup.config.ts --configPlugin esbuild",
    "build::types": "pnpm build::clean && tsc --project ./tsconfig.json --declaration true",
    "build": "pnpm build::clean && pnpm build::proc",
    "publish::major": "npm version major",
    "publish::minor": "npm version minor",
    "publish::patch": "npm version patch",
    "publish::test": "npx yalc publish",
    "docs:clean": "rimraf ./docs",
    "docs::generator": "tsx docs.ts",
    "docs": "pnpm docs:clean && pnpm docs::generator"
  },
  "keywords": [
    "pnpm",
    "rollup",
    "typescript",
    "template"
  ],
  "author": "ishiko",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/node": "^20.17.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.29.1",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.27.6",
    "typedoc-plugin-extras": "^3.1.0",
    "typedoc-plugin-katex": "^0.1.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "tsx": "^4.19.2"
  }
}